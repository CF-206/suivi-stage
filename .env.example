# Configuration Supabase (copie ce fichier en `.env` puis remplis-le)
# Le fichier `.env` est ignoré par git.
# Sur Vercel : ajoute ces variables dans les settings du projet.

# URL du projet Supabase (Project Settings > API > Project URL)
SUPABASE_URL=

# Clé publique "publishable" (Project Settings > API > publishable key)
# Ancien nom accepté aussi : SUPABASE_ANON_KEY (clé "anon").
# Ne mets JAMAIS la clé "secret" (service_role) ici.
SUPABASE_ANON_KEY=
