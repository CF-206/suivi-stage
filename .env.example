# Configuration Supabase (copie ce fichier en `.env` puis remplis-le)
# Le fichier `.env` est ignoré par git.
# Sur Vercel : ajoute ces variables dans les settings du projet.

# URL du projet Supabase (Project Settings > API > Project URL)
SUPABASE_URL=

# Clé publique "publishable" (Project Settings > API > publishable key)
# Ancien nom accepté aussi : SUPABASE_ANON_KEY (clé "anon").
# Ne mets JAMAIS la clé "secret" (service_role) ici.
SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# Relances par email (Mailjet) — variables de la serverless function
# (api/envoyer-relances.mjs). À renseigner sur Vercel, PAS dans l'app.
# ─────────────────────────────────────────────────────────────

# Clé API publique Mailjet (Account Settings > API Keys)
MAILJET_API_KEY=

# Clé API privée Mailjet
MAILJET_API_SECRET=

# Adresse expéditeur (doit être vérifiée dans Mailjet : Senders & Domains)
MAILJET_FROM_EMAIL=

# Nom de l'expéditeur (optionnel)
MAILJET_FROM_NAME=Suivi Stage

# URL publique de l'application (utilisée dans les liens des emails)
APP_URL=https://suivi-stage.vercel.app

# (Optionnel) Si défini, l'endpoint /api/envoyer-relances exige
# l'en-tête "Authorization: Bearer <CRON_SECRET>".
# CRON_SECRET=
